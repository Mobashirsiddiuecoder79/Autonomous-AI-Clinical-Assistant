# OpenAI API Key for LangChain LLM and Embeddings
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (SQLite by default, switch to PostgreSQL in production)
DATABASE_URL=sqlite:///./healthcare_agent.db

# Cryptography AES-256 Key for Encrypting Patient Identifiers (SSN, etc.)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=zP84b3FmXqY6W9J1k8D3vN4g8L0x1c2vB3n4m5a6s7d=

# Logging and Auditing Configuration
LOG_LEVEL=INFO
AUDIT_LOG_FILE=logs/audit.log
SYSTEM_LOG_FILE=logs/system.log

# Optional: Path to Tesseract OCR executable (only if not in system PATH)
# TESSERACT_CMD=/usr/local/bin/tesseract
